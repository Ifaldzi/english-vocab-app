# WordDeck environment configuration

# SQLite database
DATABASE_PATH=./data/worddeck.db

# Calendar and word-selection settings
APP_TIMEZONE=Asia/Jakarta
RECALL_PROBABILITY=0.1

# Sentence validation
# Use "ai" when GEMINI_API_KEY is configured, or "keyword" for local validation.
SENTENCE_VALIDATOR=keyword
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Analytics client tracking
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics Measurement Protocol server forwarding
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
